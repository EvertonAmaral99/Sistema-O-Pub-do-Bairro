{
  "$schema": "https://railway.com/railway.schema.json",
  "build": { "builder": "RAILPACK", "buildCommand": "npm run railway:build" },
  "deploy": { "preDeployCommand": "npm run db:migrate", "startCommand": "npm run railway:start", "healthcheckPath": "/api/health", "healthcheckTimeout": 120, "restartPolicyType": "ON_FAILURE", "restartPolicyMaxRetries": 3 }
}
